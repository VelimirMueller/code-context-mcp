{
  "name": "vlm-code-context-mcp",
  "version": "3.0.1",
  "description": "AI-powered virtual IT department via MCP — codebase intelligence, 9-agent scrum team, sprint management, and React dashboard in one npm package",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.10.1",
  "main": "dist/server/index.js",
  "bin": {
    "code-context": "dist/server/index.js",
    "code-context-sprint": "dist/server/sprint.js",
    "vlm-code-context-mcp": "dist/server/index.js",
    "code-context-mcp": "dist/server/setup.js",
    "code-context-dashboard": "dist/dashboard/dashboard.js",
    "code-context-statusline": "dist/server/statusline.js",
    "code-context-reindex": "dist/server/reindex-cli.js",
    "code-context-sync-github": "dist/server/sync-github-cli.js"
  },
  "files": [
    "dist",
    ".claude/commands",
    "scripts",
    "!scripts/bench",
    "!scripts/research",
    "!scripts/format-changed.mjs",
    "!scripts/check-contract-change.mjs",
    "!scripts/check-visual-change.mjs",
    "!scripts/check-defaults.sh",
    "!scripts/visual.sh",
    "comparison.json",
    "benchmark-results.json",
    "benchmark-stochastic-results.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/compile-skills.mjs && tsc && cp src/dashboard/dashboard.html dist/dashboard/ && node -e \"require('fs').rmSync('dist/dashboard/assets',{recursive:true,force:true})\" && cd src/dashboard/frontend && pnpm exec vite build && node ../../../scripts/check-dist-token.mjs",
    "start": "node dist/server/index.js",
    "dev": "tsx src/dashboard/dashboard.ts",
    "dashboard": "tsx src/dashboard/dashboard.ts",
    "dashboard:dev": "cd src/dashboard/frontend && pnpm exec vite --port 5173",
    "dashboard:build": "cd src/dashboard/frontend && pnpm exec vite build",
    "setup": "node dist/server/setup.js",
    "test": "vitest run",
    "bench": "tsx scripts/bench/run-simulated.mts",
    "bench:publish": "tsx scripts/bench/publish.mts",
    "bench:live": "tsx scripts/bench/live/run.mts",
    "bench:rescore": "tsx scripts/bench/rescore.mts",
    "bench:renormalize": "tsx scripts/bench/renormalize.mts",
    "bench:dry": "tsx scripts/bench/live/dry-check.mts",
    "bench:suite-check": "tsx scripts/bench/live/suite-check.mts",
    "research:import-accuracy": "tsx scripts/research/import-graph-accuracy.mts .",
    "test:frontend": "cd src/dashboard/frontend && pnpm exec vitest run",
    "test:all": "vitest run && cd src/dashboard/frontend && pnpm exec vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "contract:test": "vitest run test/contract",
    "contract:update": "CONTRACT_UPDATE=1 vitest run test/contract",
    "contract:check": "node scripts/check-contract-change.mjs",
    "lint": "eslint .",
    "typecheck:dashboard": "tsc --noEmit -p src/dashboard/frontend",
    "check:dashboard-reachable": "node scripts/check-dashboard-reachable.mjs",
    "check:dist-token": "node scripts/check-dist-token.mjs",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "format:changed": "node scripts/format-changed.mjs",
    "test:e2e": "playwright test",
    "test:visual": "sh scripts/visual.sh",
    "check:commands": "node scripts/check-commands.mjs",
    "compile:skills": "node scripts/compile-skills.mjs",
    "sync:skills": "node scripts/sync-skills.mjs && node scripts/compile-skills.mjs",
    "postinstall": "node scripts/postinstall.js",
    "prepublishOnly": "pnpm run build",
    "prepare": "husky"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "better-sqlite3": "^12.8.0",
    "chokidar": "^5.0.0",
    "dayjs": "^1.11.20",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.59.1",
    "@remotion/cli": "^4.0.532",
    "@remotion/renderer": "^4.0.532",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.1",
    "eslint": "^10.2.0",
    "eslint-plugin-better-tailwindcss": "4.9.0",
    "framer-motion": "^12.38.0",
    "husky": "^9.1.7",
    "jsdom": "^29.0.1",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "remotion": "^4.0.532",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.3",
    "vitest": "^4.1.1",
    "zustand": "^5.0.12"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "code-context",
    "codebase-indexer",
    "ai-agents",
    "scrum",
    "sprint-management",
    "virtual-team",
    "sqlite",
    "react-dashboard",
    "claude",
    "developer-tools",
    "project-management",
    "kanban",
    "retrospective"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VelimirMueller/code-context-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/VelimirMueller/code-context-mcp/issues"
  },
  "homepage": "https://github.com/VelimirMueller/code-context-mcp#readme",
  "license": "MIT"
}
