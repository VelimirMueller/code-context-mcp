/**
 * Large live-bench fixture (CCA-09, #124): a deterministic synthetic
 * TypeScript codebase of ~690 files, generated at prepare time.
 *
 * Why synthetic and not a vendored OSS repo: the answers must be exact and
 * pinned, the repo must not grow by megabytes, and unit tests must run
 * without network. A seeded generator (no Math.random, no clock) gives the
 * same bytes on every machine; answers.json pins its sha256 and the answer
 * key, and writeLargeFixture() refuses to hand out a drifted tree. Licence:
 * all code here is generated by this file, so it carries the repo's licence;
 * no third-party code is vendored.
 *
 * Shape (what makes it realistic for import-graph questions):
 * - 20 business domains (src/<domain>/), each with model/, repo/, service/,
 *   api/, a helpers dir, events/, validation/, jobs/, __tests__/ and an
 *   index.ts barrel (`export *` and `export { … } from`);
 * - a shared kernel (src/core/ + barrel) and platform layers (src/platform/
 *   db, http, cache, queue, telemetry), a composition root (src/app/);
 * - type-only imports, `.js`-suffixed specifiers, directory imports,
 *   namespace imports, destructured and plain dynamic `import()`;
 * - cross-domain imports through barrels, which form import cycles;
 * - dead exports (most helpers are never imported);
 * - decoys for the index-shaped tasks: same-named local functions and
 *   constants, stale comments, prefix names (`formatMoneyRange`,
 *   `resolveTaxRateLegacy`), a sibling module with a similar name
 *   (`retry-budget.ts`).
 *
 * The code type-checks under `tsc --strict` (answer-key.mts asserts zero
 * diagnostics). Regenerate the pinned key after any change here:
 *   npx tsx scripts/bench/live/large-fixture/answer-key.mts --write
 */
import { createHash } from 'node:crypto';
import fs from 'node:fs';
import path from 'node:path';
import { fileURLToPath } from 'node:url';

/** Bump when the generator output changes on purpose (recorded in answers.json). */
export const GENERATOR_VERSION = 1;
const SEED = 0x0c0a09;

const scriptDir = path.dirname(fileURLToPath(import.meta.url));
export const ANSWERS_PATH = path.join(scriptDir, 'answers.json');

// ---- deterministic randomness ------------------------------------------------

function mulberry32(seed: number): () => number {
  let a = seed >>> 0;
  return () => {
    a = (a + 0x6d2b79f5) >>> 0;
    let t = a;
    t = Math.imul(t ^ (t >>> 15), t | 1);
    t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

// ---- names -------------------------------------------------------------------

const pascal = (kebab: string): string =>
  kebab
    .split('-')
    .map((w) => w[0].toUpperCase() + w.slice(1))
    .join('');
const camel = (kebab: string): string => {
  const p = pascal(kebab);
  return p[0].toLowerCase() + p.slice(1);
};
const upper = (kebab: string): string => kebab.replace(/-/g, '_').toUpperCase();
const snake = (kebab: string): string => kebab.replace(/-/g, '_');

interface Domain {
  name: string;
  entities: [string, string, string, string];
  /** Folder of the generic helpers (catalog keeps utils/ for hand-written files). */
  helpers: string;
}

const DOMAINS: Domain[] = (
  [
    ['accounts', ['account', 'account-member', 'workspace', 'invitation']],
    ['analytics', ['metric-sample', 'dashboard-view', 'funnel', 'cohort']],
    ['auth', ['session', 'credential', 'api-token', 'login-attempt']],
    ['billing', ['invoice', 'credit-note', 'billing-account', 'statement']],
    ['catalog', ['product', 'variant', 'collection', 'attribute-set']],
    ['checkout', ['cart', 'cart-item', 'checkout-session', 'address-draft']],
    ['customers', ['customer', 'customer-segment', 'contact-preference', 'customer-note']],
    ['inventory', ['stock-level', 'warehouse', 'stock-movement', 'reservation']],
    ['loyalty', ['points-account', 'tier', 'reward', 'redemption']],
    ['media', ['asset', 'rendition', 'upload-ticket', 'media-folder']],
    ['notifications', ['notification', 'message-template', 'delivery', 'channel-preference']],
    ['orders', ['order', 'order-line', 'fulfillment', 'order-note']],
    ['payments', ['payment', 'refund', 'payment-method', 'payout']],
    ['pricing', ['price-list', 'price-rule', 'discount-tier', 'currency-rate']],
    ['promotions', ['campaign', 'coupon', 'promotion-rule', 'voucher-batch']],
    ['returns', ['return-request', 'return-label', 'inspection', 'restock']],
    ['reviews', ['review', 'review-vote', 'moderation-case', 'rating-summary']],
    ['search', ['search-index', 'query-log', 'synonym', 'facet']],
    ['shipping', ['shipment', 'parcel', 'carrier-account', 'tracking-event']],
    ['support', ['ticket', 'ticket-reply', 'support-macro', 'sla-policy']],
  ] as Array<[string, Domain['entities']]>
).map(([name, entities]) => ({
  name,
  entities,
  helpers: name === 'catalog' ? 'helpers' : 'utils',
}));

// ---- module builder ------------------------------------------------------------

/** Relative module specifier from file `from` to file `to` (index.ts → its directory). */
export function specifier(from: string, to: string, js = false): string {
  const isIndex = to.endsWith('/index.ts');
  const target = isIndex ? path.posix.dirname(to) : to.replace(/\.ts$/, '');
  let rel = path.posix.relative(path.posix.dirname(from), target);
  if (!rel.startsWith('.')) rel = `./${rel}`;
  return js && !isIndex ? `${rel}.js` : rel;
}

class Mod {
  private readonly named = new Map<string, { values: Set<string>; types: Set<string> }>();
  private readonly lines: string[] = [];
  readonly body: string[] = [];

  constructor(
    readonly path: string,
    readonly doc: string,
  ) {}

  /** Named import of `names` from file `to` (merged per specifier). */
  use(to: string, names: string[], opts: { type?: boolean; js?: boolean } = {}): this {
    const s = specifier(this.path, to, opts.js);
    const entry = this.named.get(s) ?? { values: new Set<string>(), types: new Set<string>() };
    for (const n of names) {
      if (opts.type) {
        if (!entry.values.has(n)) entry.types.add(n);
      } else {
        entry.types.delete(n);
        entry.values.add(n);
      }
    }
    this.named.set(s, entry);
    return this;
  }

  /** A raw import/export line (namespace import, re-export), kept after the named imports. */
  line(raw: string): this {
    this.lines.push(raw);
    return this;
  }

  add(chunk: string): this {
    this.body.push(chunk.trim());
    return this;
  }

  render(): string {
    const head: string[] = [];
    for (const [s, { values, types }] of this.named) {
      const all = [...values]
        .map((n) => ({ n, t: false }))
        .concat([...types].map((n) => ({ n, t: true })));
      all.sort((a, b) => (a.n < b.n ? -1 : a.n > b.n ? 1 : 0));
      if (values.size === 0) {
        head.push(`import type { ${all.map((x) => x.n).join(', ')} } from '${s}';`);
      } else {
        head.push(
          `import { ${all.map((x) => (x.t ? `type ${x.n}` : x.n)).join(', ')} } from '${s}';`,
        );
      }
    }
    head.push(...this.lines);
    const parts = [`/**\n * ${this.doc}\n */`];
    if (head.length) parts.push(head.join('\n'));
    parts.push(...this.body);
    return `${parts.join('\n\n')}\n`;
  }
}

// ---- generator -----------------------------------------------------------------

/** Generate the fixture: workspace-relative path → file content, sorted by path. */
export function generateLargeFixture(): Map<string, string> {
  const rnd = mulberry32(SEED);
  const chance = (p: number): boolean => rnd() < p;
  const pick = <T,>(xs: readonly T[]): T => xs[Math.floor(rnd() * xs.length)];

  const mods = new Map<string, Mod>();
  const plain = new Map<string, string>();
  const mod = (p: string, doc: string): Mod => {
    if (mods.has(p) || plain.has(p)) throw new Error(`generator: duplicate file ${p}`);
    const m = new Mod(p, doc);
    mods.set(p, m);
    return m;
  };
  const get = (p: string): Mod => {
    const m = mods.get(p);
    if (!m) throw new Error(`generator: no module ${p}`);
    return m;
  };

  const CORE = 'src/core/index.ts';
  const core = (m: string): string => `src/core/${m}.ts`;
  /** Half the kernel imports go through the barrel, half straight to the module. */
  const coreFrom = (m: string): string => (chance(0.5) ? CORE : core(m));
  const js = (): boolean => chance(0.12);

  genKernel(mod, plain);
  genPlatform(mod, plain);

  // Files that the hand-made scenarios below own: no random formatMoney use there.
  const NO_RANDOM_MONEY = new Set([
    'src/billing/service/statement-service.ts',
    'src/pricing/service/price-list-service.ts',
    'src/analytics/service/metric-sample-service.ts',
    'src/promotions/api/campaign-handler.ts',
  ]);

  for (const d of DOMAINS) {
    const D = pascal(d.name);
    const dc = camel(d.name);
    const DU = upper(d.name);
    const base = `src/${d.name}`;
    const H = `${base}/${d.helpers}`;
    const model = (e: string): string => `${base}/model/${e}.ts`;
    const others = DOMAINS.filter((o) => o.name !== d.name);

    // model/
    d.entities.forEach((e, i) => {
      const P = pascal(e);
      const m = mod(model(e), `${P} record of the ${d.name} domain.`);
      const idFrom = coreFrom('ids');
      m.use(idFrom, ['newId']).use(idFrom, ['Id'], { type: true });
      m.use(coreFrom('money'), ['Money'], { type: true, js: js() });
      const extra = pick([
        'note: string | null;',
        'tags: readonly string[];',
        'ownerId: string | null;',
      ]);
      const extraInit = extra.startsWith('tags') ? 'tags: []' : `${extra.split(':')[0]}: null`;
      m.add(`export interface ${P} {
  readonly id: Id<'${camel(e)}'>;
  status: ${P}Status;
  label: string;
  readonly createdAt: string;
  updatedAt: string;
  total: Money | null;
  ${extra}
}`);
      m.add(`export type ${P}Status = 'draft' | 'active' | 'archived';`);
      m.add(
        `export const ${upper(e)}_STATUSES: readonly ${P}Status[] = ['draft', 'active', 'archived'];`,
      );
      m.add(`/** Build a ${e.replace(/-/g, ' ')} with defaults; \`input\` wins. */
export function create${P}(seq: number, input: Partial<${P}> = {}): ${P} {
  const at = input.createdAt ?? '2026-01-0${(i % 9) + 1}T00:00:00.000Z';
  return {
    id: newId('${camel(e)}', seq),
    status: 'draft',
    label: \`${P} #\${seq}\`,
    createdAt: at,
    updatedAt: at,
    total: null,
    ${extraInit},
    ...input,
  };
}`);
      m.add(`export function is${P}Active(item: ${P}): boolean {
  return item.status === 'active';
}`);
    });

    // repo/ (entities 0..2)
    d.entities.slice(0, 3).forEach((e) => {
      const P = pascal(e);
      const m = mod(
        `${base}/repo/${e}-repo.ts`,
        `Persistence for ${e.replace(/-/g, ' ')} records.`,
      );
      m.use('src/platform/db/index.ts', ['insertRow', 'selectRows'])
        .use('src/platform/db/index.ts', ['Connection', 'Row'], { type: true })
        .use(coreFrom('errors'), ['NotFoundError'])
        .use(model(e), [`create${P}`])
        .use(model(e), [P], { type: true, js: js() });
      m.add(`const TABLE = '${snake(d.name)}_${snake(e)}';`);
      m.add(`function to${P}(row: Row, seq: number): ${P} {
  return create${P}(seq, { label: typeof row.label === 'string' ? row.label : \`${e} \${seq}\` });
}`);
      m.add(`export interface ${P}Repo {
  find(id: string): Promise<${P}>;
  list(limit?: number): Promise<${P}[]>;
  save(item: ${P}): Promise<void>;
}`);
      m.add(`export function create${P}Repo(conn: Connection): ${P}Repo {
  return {
    async find(id) {
      const rows = await selectRows(conn, TABLE, { id });
      const row = rows[0];
      if (!row) throw new NotFoundError('${e}', id);
      return to${P}(row, 0);
    },
    async list(limit = 50) {
      const rows = await selectRows(conn, TABLE);
      return rows.slice(0, limit).map(to${P});
    },
    async save(item) {
      await insertRow(conn, TABLE, { ...item });
    },
  };
}`);
    });

    // service/
    d.entities.forEach((e, i) => {
      const P = pascal(e);
      const p = `${base}/service/${e}-service.ts`;
      const m = mod(p, `${P} use cases: lookup, activation, descriptions.`);
      const evFrom = coreFrom('events');
      m.use(evFrom, ['createEvent']);
      m.use(core('config'), ['ServiceDeps'], { type: true });
      m.use(model(e), [`is${P}Active`]).use(model(e), [P], { type: true });
      m.use(`${H}/labels.ts`, [`format${P}Label`], { js: js() });
      const describe: string[] = [`summarize${P}(item)`];
      const nCross = chance(0.5) ? (chance(0.35) ? 2 : 1) : 0;
      const crossed = new Set<string>();
      for (let k = 0; k < nCross; k++) {
        const o = pick(others);
        if (crossed.has(o.name)) continue;
        crossed.add(o.name);
        const Q = pascal(o.entities[chance(0.5) ? 0 : 1]);
        m.use(`src/${o.name}/index.ts`, [`create${Q}`, `summarize${Q}`]);
        describe.push(`summarize${Q}(create${Q}(${k + 1}))`);
      }
      if (!NO_RANDOM_MONEY.has(p) && chance(0.17)) {
        const from = chance(0.6) ? CORE : core('money');
        m.use(from, ['formatMoney', 'ZERO_EUR']);
        describe.push('formatMoney(item.total ?? ZERO_EUR)');
      }
      m.add(`export interface ${P}Service {
  get(id: string): Promise<${P}>;
  activate(id: string): Promise<${P}>;
  describe(item: ${P}): string;
}`);
      m.add(`export function summarize${P}(item: ${P}): string {
  return \`\${format${P}Label(item)} (\${is${P}Active(item) ? 'active' : item.status})\`;
}`);
      const findBody =
        i < 3
          ? `return repo.find(id);`
          : `const item = store.get(id);
      if (!item) throw new NotFoundError('${e}', id);
      return item;`;
      const save = i < 3 ? `await repo.save(next);` : `store.set(next.id, next);`;
      const load = i < 3 ? `await repo.find(id)` : `await this.get(id)`;
      if (i < 3) m.use(`${base}/repo/${e}-repo.ts`, [`${P}Repo`], { type: true });
      else m.use(coreFrom('errors'), ['NotFoundError']);
      const param = i < 3 ? `repo: ${P}Repo` : `store: Map<string, ${P}> = new Map()`;
      m.add(`export function create${P}Service(deps: ServiceDeps, ${param}): ${P}Service {
  const log = deps.logger.child('${e}');
  return {
    async get(id) {
      log.debug(\`get \${id}\`);
      ${findBody}
    },
    async activate(id) {
      const item = ${load};
      const next: ${P} = { ...item, status: 'active', updatedAt: '2026-02-01T00:00:00.000Z' };
      ${save}
      deps.bus.publish(createEvent('${d.name}.${e}.activated', { id }));
      return next;
    },
    describe(item) {
      const parts = [${describe.join(', ')}];
      return parts.join(' | ');
    },
  };
}`);
    });
    {
      const m = mod(`${base}/service/${d.name}-policy.ts`, `Who may do what in ${d.name}.`);
      m.use('src/platform/feature-flags.ts', ['isEnabled']).use(
        'src/platform/feature-flags.ts',
        ['FlagName'],
        { type: true },
      );
      m.add(`export const ${DU}_ACTIONS = ['read', 'write', 'archive'] as const;`);
      m.add(`export type ${D}Action = (typeof ${DU}_ACTIONS)[number];`);
      m.add(`export function ${dc}Allows(action: ${D}Action, flag: FlagName = '${pick(['new-checkout', 'fast-search', 'loyalty-v2', 'returns-portal'])}'): boolean {
  return action === 'read' || isEnabled(flag);
}`);
    }

    // api/
    d.entities.slice(0, 3).forEach((e) => {
      const P = pascal(e);
      const m = mod(
        `${base}/api/${e}-handler.ts`,
        `HTTP handlers for ${e.replace(/-/g, ' ')} resources.`,
      );
      m.use('src/platform/http/index.ts', ['json', 'notFound']).use(
        'src/platform/http/index.ts',
        ['Handler'],
        { type: true },
      );
      m.use(`${base}/service/${e}-service.ts`, [`${P}Service`], { type: true });
      m.use(`${H}/mapping.ts`, [`to${P}Dto`]);
      m.add(`export function makeGet${P}Handler(service: ${P}Service): Handler {
  return async (req) => {
    const id = req.params.id;
    if (!id) return notFound('${e}');
    return json(to${P}Dto(await service.get(id)));
  };
}`);
      m.add(`export function makeActivate${P}Handler(service: ${P}Service): Handler {
  return async (req) => {
    const id = req.params.id;
    if (!id) return notFound('${e}');
    const item = await service.activate(id);
    return json({ ...to${P}Dto(item), activated: true });
  };
}`);
    });
    {
      const m = mod(`${base}/api/routes.ts`, `Route table of the ${d.name} domain.`);
      m.use('src/platform/http/index.ts', ['Router'], { type: true });
      const deps: string[] = [];
      const regs: string[] = [];
      for (const e of d.entities.slice(0, 3)) {
        const P = pascal(e);
        m.use(`${base}/api/${e}-handler.ts`, [`makeActivate${P}Handler`, `makeGet${P}Handler`]);
        m.use(`${base}/service/${e}-service.ts`, [`${P}Service`], { type: true });
        deps.push(`  readonly ${camel(e)}Service: ${P}Service;`);
        regs.push(
          `  router.get('/${d.name}/${e}s/:id', makeGet${P}Handler(deps.${camel(e)}Service));`,
          `  router.post('/${d.name}/${e}s/:id/activate', makeActivate${P}Handler(deps.${camel(e)}Service));`,
        );
      }
      m.add(`export interface ${D}RouteDeps {\n${deps.join('\n')}\n}`);
      m.add(
        `export function register${D}Routes(router: Router, deps: ${D}RouteDeps): Router {\n${regs.join('\n')}\n  return router;\n}`,
      );
    }

    // helpers (generic; most of these exports are never imported)
    {
      const labels = mod(`${H}/labels.ts`, `Display labels for ${d.name} records.`);
      labels.use(core('strings'), ['titleCase']);
      const keys = mod(`${H}/keys.ts`, `Lookup keys and references for ${d.name} records.`);
      const nsStrings = chance(0.35);
      if (nsStrings)
        keys.line(`import * as strings from '${specifier(keys.path, core('strings'))}';`);
      else keys.use(core('strings'), ['slugify']);
      const mapping = mod(`${H}/mapping.ts`, `DTO mapping for ${d.name} records.`);
      const sorting = mod(`${H}/sorting.ts`, `Ordering helpers for ${d.name} records.`);
      for (const e of d.entities) {
        const P = pascal(e);
        for (const m of [labels, mapping, sorting]) m.use(model(e), [P], { type: true, js: js() });
        labels.add(`export function format${P}Label(item: ${P}): string {
  return \`\${titleCase('${e.replace(/-/g, ' ')}')} \${item.label}\`;
}`);
        keys.add(`export function normalize${P}Key(raw: string): string {
  return ${nsStrings ? 'strings.slugify' : 'slugify'}(raw).slice(0, 64);
}`);
        keys.add(`export function parse${P}Ref(ref: string): string | null {
  return ref.startsWith('${camel(e)}_') ? ref : null;
}`);
        mapping.add(`export interface ${P}Dto {
  readonly id: string;
  readonly label: string;
  readonly status: string;
}`);
        mapping.add(`export function to${P}Dto(item: ${P}): ${P}Dto {
  return { id: item.id, label: item.label, status: item.status };
}`);
        sorting.add(`export function compare${P}ByDate(a: ${P}, b: ${P}): number {
  return a.createdAt.localeCompare(b.createdAt);
}`);
        sorting.add(`export function sort${P}List(items: readonly ${P}[]): ${P}[] {
  return [...items].sort(compare${P}ByDate);
}`);
      }
    }

    // events/
    {
      const ev = mod(`${base}/events/${d.name}-events.ts`, `Event names published by ${d.name}.`);
      ev.add(
        `export const ${DU}_EVENTS = {\n${d.entities.map((e) => `  ${camel(e)}Activated: '${d.name}.${e}.activated',`).join('\n')}\n} as const;`,
      );
      ev.add(`export type ${D}EventName = (typeof ${DU}_EVENTS)[keyof typeof ${DU}_EVENTS];`);
      ev.add(`export interface ${D}EventPayload {\n  readonly id: string;\n}`);
      ev.add(`export function is${D}Event(name: string): name is ${D}EventName {
  return (Object.values(${DU}_EVENTS) as string[]).includes(name);
}`);
      const pub = mod(`${base}/events/publisher.ts`, `Publishes ${d.name} events on the bus.`);
      pub.use(core('events'), ['createEvent']).use(core('events'), ['EventBus'], { type: true });
      pub.use(ev.path, [`${D}EventName`, `${D}EventPayload`], { type: true });
      pub.add(`export function publish${D}Event(bus: EventBus, name: ${D}EventName, payload: ${D}EventPayload): number {
  return bus.publish(createEvent(name, { ...payload }));
}`);
      const hd = mod(`${base}/events/handlers.ts`, `Reactions of ${d.name} to other domains.`);
      hd.use(core('events'), ['EventBus'], { type: true }).use(core('logger'), ['Logger'], {
        type: true,
      });
      const subs: string[] = [];
      const seen = new Set<string>();
      for (let k = 0; k < (chance(0.5) ? 2 : 1); k++) {
        const o = pick(others);
        if (seen.has(o.name)) continue;
        seen.add(o.name);
        hd.use(`src/${o.name}/events/${o.name}-events.ts`, [`${upper(o.name)}_EVENTS`], {
          js: js(),
        });
        const oe = camel(pick(o.entities));
        subs.push(
          `    bus.subscribe(${upper(o.name)}_EVENTS.${oe}Activated, (event) => log.info(\`${d.name} saw \${event.name}\`)),`,
        );
      }
      hd.add(
        `export function register${D}Handlers(bus: EventBus, log: Logger): Array<() => void> {\n  return [\n${subs.join('\n')}\n  ];\n}`,
      );
    }

    // validation/
    d.entities.slice(0, 2).forEach((e) => {
      const P = pascal(e);
      const m = mod(
        `${base}/validation/${e}-schema.ts`,
        `Input validation for ${e.replace(/-/g, ' ')} records.`,
      );
      m.use(coreFrom('errors'), ['ValidationError'])
        .use(core('guards'), ['isNonEmpty'])
        .use(model(e), [P], { type: true });
      m.add(`export function validate${P}(input: Partial<${P}>): Partial<${P}> {
  if (!isNonEmpty(input.label)) throw new ValidationError('label', 'is required');
  return input;
}`);
    });
    {
      const [e0, e1] = d.entities;
      const m = mod(`${base}/validation/rules.ts`, `Validation entry points for ${d.name}.`);
      m.use(`${base}/validation/${e0}-schema.ts`, [`validate${pascal(e0)}`]);
      m.use(`${base}/validation/${e1}-schema.ts`, [`validate${pascal(e1)}`]);
      m.add(`export const ${DU}_VALIDATORS = {
  ${camel(e0)}: validate${pascal(e0)},
  ${camel(e1)}: validate${pascal(e1)},
} as const;`);
      m.add(`export function validate${D}Input(kind: keyof typeof ${DU}_VALIDATORS, input: Record<string, unknown>): boolean {
  try {
    ${DU}_VALIDATORS[kind]({ label: String(input.label ?? '') });
    return true;
  } catch {
    return false;
  }
}`);
    }

    // jobs/
    {
      const sync = mod(
        `${base}/jobs/${d.name}-sync-job.ts`,
        `Schedules the nightly ${d.name} sync.`,
      );
      sync
        .use('src/platform/queue/index.ts', ['JobQueue'], { type: true })
        .use('src/platform/telemetry/index.ts', ['increment']);
      sync.add(`export function schedule${D}Sync(queue: JobQueue, batch = ${pick([50, 100, 200, 500])}): number {
  increment('${d.name}.sync.scheduled');
  return queue.enqueue('${d.name}.sync', { batch });
}`);
      const clean = mod(
        `${base}/jobs/${d.name}-cleanup-job.ts`,
        `Removes stale ${d.name} records.`,
      );
      const P = pascal(d.entities[2]);
      clean.add(`export async function run${D}Cleanup(): Promise<number> {
  const { sort${P}List } = await import('${specifier(clean.path, `${H}/sorting.ts`)}');
  return sort${P}List([]).length;
}`);
    }

    // __tests__/
    d.entities.slice(0, 2).forEach((e) => {
      const P = pascal(e);
      const m = mod(`${base}/__tests__/${e}-service.spec.ts`, `Unit tests for summarize${P}.`);
      m.line(`import { describe, expect, it } from 'vitest';`);
      m.use(model(e), [`create${P}`]).use(`${base}/service/${e}-service.ts`, [`summarize${P}`]);
      m.add(`describe('summarize${P}', () => {
  it('describes a draft', () => {
    expect(summarize${P}(create${P}(1))).toContain('draft');
  });
});`);
    });

    // index.ts barrel
    {
      const m = mod(
        `${base}/index.ts`,
        `Public surface of the ${d.name} domain. Other domains import from here.`,
      );
      for (const e of d.entities) m.line(`export * from './model/${e}';`);
      for (const e of d.entities) {
        const P = pascal(e);
        m.line(`export { create${P}Service, summarize${P} } from './service/${e}-service';`);
        m.line(`export type { ${P}Service } from './service/${e}-service';`);
      }
      m.line(`export { register${D}Routes } from './api/routes';`);
      m.line(`export type { ${D}RouteDeps } from './api/routes';`);
      m.line(`export { ${DU}_EVENTS } from './events/${d.name}-events';`);
      m.line(`export type { ${D}EventName } from './events/${d.name}-events';`);
      m.line(`export { ${dc}Allows } from './service/${d.name}-policy';`);
    }
  }

  genApp(mod, get);
  applyScenarios(mod, get, plain);

  const out = new Map<string, string>();
  for (const [p, m] of mods) out.set(p, m.render());
  for (const [p, c] of plain) out.set(p, c);
  return new Map([...out].sort((a, b) => (a[0] < b[0] ? -1 : a[0] > b[0] ? 1 : 0)));
}

