}

function genApp(mod: ModFactory, get: (p: string) => Mod): void {
  void get;
  const container = mod('src/app/container.ts', 'Composition root: builds every service once.');
  container
    .use('src/core/index.ts', ['EventBus', 'createLogger', 'loadConfig'])
    .use('src/core/index.ts', ['AppConfig', 'ServiceDeps'], { type: true })
    .use('src/platform/db/index.ts', ['createMemoryConnection']);
  const entries: string[] = [];
  for (const d of DOMAINS) {
    const svc: string[] = [];
    for (const e of d.entities.slice(0, 3)) {
      const P = pascal(e);
      container.use(`src/${d.name}/index.ts`, [`create${P}Service`]);
      container.use(`src/${d.name}/repo/${e}-repo.ts`, [`create${P}Repo`]);
      svc.push(`      ${camel(e)}Service: create${P}Service(deps, create${P}Repo(conn)),`);
    }
    entries.push(`    ${camel(d.name)}: {\n${svc.join('\n')}\n    },`);
  }
  container.add(`export function buildContainer(env: AppConfig['env'] = 'dev') {
  const deps: ServiceDeps = { logger: createLogger('app'), bus: new EventBus(), config: loadConfig({ env }) };
  const conn = createMemoryConnection();
  return {
    deps,
${entries.join('\n')}
  };
}`);
  container.add(`export type Container = ReturnType<typeof buildContainer>;`);

  const routes = mod('src/app/routes.ts', 'Mounts every domain route table.');
  routes
    .use('src/platform/http/index.ts', ['Router'])
    .use('src/app/container.ts', ['Container'], { type: true });
  const regs: string[] = [];
  for (const d of DOMAINS) {
    routes.use(`src/${d.name}/index.ts`, [`register${pascal(d.name)}Routes`]);
    regs.push(`  register${pascal(d.name)}Routes(router, container.${camel(d.name)});`);
  }
  routes.add(`export function buildRouter(container: Container): Router {
  const router = new Router();
${regs.join('\n')}
  return router;
}`);

  const jobs = mod('src/app/jobs.ts', 'Schedules every domain job.');
  jobs.use('src/platform/queue/index.ts', ['JobQueue']);
  const calls: string[] = [];
  for (const d of DOMAINS) {
    jobs.use(`src/${d.name}/jobs/${d.name}-sync-job.ts`, [`schedule${pascal(d.name)}Sync`]);
    calls.push(`    schedule${pascal(d.name)}Sync(queue),`);
  }
  jobs.add(`export function scheduleAll(queue: JobQueue = new JobQueue()): number {
  return [
${calls.join('\n')}
  ].reduce((a, b) => a + b, 0);
}`);

  const boot = mod('src/app/bootstrap.ts', 'Starts the application.');
  boot
    .use('src/app/container.ts', ['buildContainer'])
    .use('src/app/container.ts', ['Container'], { type: true })
    .use('src/app/routes.ts', ['buildRouter'])
    .use('src/app/jobs.ts', ['scheduleAll'])
    .use('src/core/logger.ts', ['createLogger']);
  const handlerDomains = DOMAINS.filter((_, i) => i % 3 === 0);
  const hcalls: string[] = [];
  for (const d of handlerDomains) {
    boot.use(`src/${d.name}/events/handlers.ts`, [`register${pascal(d.name)}Handlers`]);
    hcalls.push(`  register${pascal(d.name)}Handlers(container.deps.bus, log);`);
  }
  boot.add(`export async function bootstrap(): Promise<{ container: Container; routes: number; jobs: number }> {
  const container = buildContainer();
  const log = createLogger('bootstrap');
${hcalls.join('\n')}
  const routes = buildRouter(container).size();
  const jobs = scheduleAll();
  log.info(\`ready: \${routes} routes, \${jobs} jobs\`);
  return { container, routes, jobs };
}`);

  mod('src/app/server.ts', 'HTTP server entry point.')
    .use('src/app/bootstrap.ts', ['bootstrap'])
    .use('src/platform/http/index.ts', ['compose', 'withLogging'])
    .use('src/core/logger.ts', ['createLogger'])
    .add(`export async function startServer(port = 8080): Promise<string> {
  const app = await bootstrap();
  const log = createLogger('server');
  compose(withLogging(log));
  return \`listening on \${port} with \${app.routes} routes\`;
}`);

  for (const name of [
    'audit-trail',
    'rate-limit',
    'request-id',
    'cors',
    'compression',
    'maintenance',
    'locale',
    'feature-gate',
  ]) {
    mod(`src/app/plugins/${name}.ts`, `${pascal(name)} plugin.`)
      .use('src/platform/http/index.ts', ['Middleware'], { type: true })
      .use('src/platform/telemetry/index.ts', ['increment'])
      .add(`export default function register${pascal(name)}Plugin(): Middleware {
  return (next) => async (req) => {
    increment('plugin.${name}');
    return next(req);
  };
}`);
  }
}

