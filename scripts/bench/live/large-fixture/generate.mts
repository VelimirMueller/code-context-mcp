      2,
    )}\n`,
  );
  plain.set(
    'tsconfig.json',
    `${JSON.stringify(
      {
        compilerOptions: {
          target: 'ES2022',
          lib: ['ES2022'],
          module: 'ESNext',
          moduleResolution: 'Bundler',
          strict: true,
          noEmit: true,
          skipLibCheck: true,
          types: [],
        },
        include: ['src'],
      },
      null,
      2,
    )}\n`,
  );
  plain.set(
    'README.md',
    `# acme-commerce

Modular commerce backend in TypeScript.

- \`src/core/\` shared kernel (ids, money, errors, events, logging)
- \`src/platform/\` infrastructure (db, http, cache, queue, telemetry)
- \`src/<domain>/\` one folder per business domain; other domains import its \`index.ts\`
- \`src/app/\` composition root, routes and job scheduling
`,
