// ---- integrity -----------------------------------------------------------------

/** sha256 over `path\0content\0` of every file, in path order. */
export function fixtureHash(files: Map<string, string>): string {
  const h = createHash('sha256');
  for (const p of [...files.keys()].sort()) h.update(`${p}\0${files.get(p)}\0`);
  return h.digest('hex');
}

export interface PinnedFixture {
  generatorVersion: number;
  files: number;
  sha256: string;
}

export function readPinnedFixture(): PinnedFixture {
  const key = JSON.parse(fs.readFileSync(ANSWERS_PATH, 'utf-8')) as { fixture: PinnedFixture };
  return key.fixture;
}

let cached: { files: Map<string, string>; sha256: string } | null = null;

/** The generated tree, verified against the pinned hash once per process. */
export function verifiedLargeFixture(): Map<string, string> {
  if (!cached) {
    const files = generateLargeFixture();
    const sha256 = fixtureHash(files);
    const pinned = readPinnedFixture();
    if (sha256 !== pinned.sha256 || files.size !== pinned.files) {
      throw new Error(
        `large fixture drifted: generated ${files.size} files sha256 ${sha256}, pinned ${pinned.files} files ${pinned.sha256}. ` +
          'Regenerate the answer key (npx tsx scripts/bench/live/large-fixture/answer-key.mts --write) and review the diff.',
      );
    }
    cached = { files, sha256 };
  }
  return cached.files;
}

/** Write the verified fixture into `dir` (the session workspace). */
export function writeLargeFixture(dir: string): void {
  for (const [rel, content] of verifiedLargeFixture()) {
    const abs = path.join(dir, rel);
    fs.mkdirSync(path.dirname(abs), { recursive: true });
    fs.writeFileSync(abs, content);
  }
}
